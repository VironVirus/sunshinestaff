rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedActive() {
      return hasUserDoc() &&
        userData().approvalStatus == "approved" &&
        userData().employmentStatus == "active";
    }

    function isSuperAdmin() {
      return isApprovedActive() && userData().isSuperAdmin == true;
    }

    function isLead() {
      return isApprovedActive() &&
        (userData().jobLevel == "manager" || userData().jobLevel == "supervisor");
    }

    function belongsTo(departmentId) {
      return isApprovedActive() && userData().departmentKey == departmentId;
    }

    function isFrontOfficeManager() {
      return belongsTo("front_office") && isLead();
    }

    function isOperationsManager() {
      return isLead() && userData().keys().hasAny(["staffTitle"]) &&
        userData().staffTitle == "Operations Manager";
    }

    function isHousekeepingManager() {
      return belongsTo("housekeeping") && isLead();
    }

    function isMaintenanceManager() {
      return belongsTo("maintainance") && isLead();
    }

    function isHumanResourceManager() {
      return belongsTo("human_resource") && isLead();
    }

    function isAuditManager() {
      return belongsTo("audit") && isLead();
    }

    function isNightDutyManager() {
      return belongsTo("night_duty") && isLead();
    }

    function isStoreLead() {
      return belongsTo("store") && isLead();
    }

    function optionalListWithin(data, key, maximum) {
      return !data.keys().hasAny([key]) || (data[key] is list && data[key].size() <= maximum);
    }

    function matchesActorName(value) {
      return (userData().keys().hasAny(["fullName"]) && value == userData().fullName) ||
        (!userData().keys().hasAny(["fullName"]) && value == "");
    }

    function matchesActorDepartment(value) {
      return (userData().keys().hasAny(["departmentName"]) && value == userData().departmentName) ||
        (!userData().keys().hasAny(["departmentName"]) && value == "");
    }

    function matchesActorDepartmentKey(value) {
      return (userData().keys().hasAny(["departmentKey"]) && value == userData().departmentKey) ||
        (!userData().keys().hasAny(["departmentKey"]) && value == "");
    }

    function validDepartmentSelection(data) {
      return (data.departmentKey == "food_beverages" && data.departmentName == "Food and Beverages") ||
        (data.departmentKey == "front_office" && data.departmentName == "Front Office") ||
        (data.departmentKey == "it" && data.departmentName == "IT") ||
        (data.departmentKey == "executive_management" && data.departmentName == "Executive Management") ||
        (data.departmentKey == "maintainance" && data.departmentName == "Maintenance") ||
        (data.departmentKey == "store" && data.departmentName == "Store") ||
        (data.departmentKey == "accounts" && data.departmentName == "Accounts") ||
        (data.departmentKey == "audit" && data.departmentName == "Audit") ||
        (data.departmentKey == "human_resource" && data.departmentName == "Human Resource") ||
        (data.departmentKey == "kitchen" && data.departmentName == "Kitchen") ||
        (data.departmentKey == "security" && data.departmentName == "Security") ||
        (data.departmentKey == "housekeeping" && data.departmentName == "Housekeeping") ||
        (data.departmentKey == "night_duty" && data.departmentName == "Night Duty");
    }

    function validSelfRegistration(userId) {
      return signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          "uid", "fullName", "email", "birthday", "phoneNumber", "homeAddress",
          "departmentKey", "departmentName", "jobLevel", "staffTitle",
          "isSuperAdmin", "approvalStatus", "approvedAt", "approvedByName",
          "employmentStatus", "employmentStartDate", "surcharges", "leaveRecords",
          "monthlySalary", "payrollMonthKey", "absenceDays", "lateCount",
          "pensionAmount", "taxAmount", "salaryUpdatedAt", "salaryUpdatedByName",
          "lastProfileNotification", "lastProfileNotificationAt", "accessLevel",
          "privileges", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
        request.resource.data.email == request.auth.token.email &&
        validDepartmentSelection(request.resource.data) &&
        request.resource.data.jobLevel in ["manager", "supervisor", "line_staff"] &&
        request.resource.data.staffTitle is string && request.resource.data.staffTitle.size() <= 80 &&
        request.resource.data.birthday is string && request.resource.data.birthday.size() <= 10 &&
        request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 30 &&
        request.resource.data.homeAddress is string && request.resource.data.homeAddress.size() <= 250 &&
        request.resource.data.isSuperAdmin == false &&
        request.resource.data.approvalStatus == "pending" &&
        request.resource.data.approvedAt == "" &&
        request.resource.data.approvedByName == "" &&
        request.resource.data.employmentStatus == "active" &&
        request.resource.data.employmentStartDate is string &&
        request.resource.data.employmentStartDate.size() == 10 &&
        request.resource.data.surcharges == "" &&
        request.resource.data.leaveRecords.size() == 0 &&
        request.resource.data.monthlySalary == 0 &&
        request.resource.data.payrollMonthKey is string &&
        request.resource.data.payrollMonthKey.size() == 7 &&
        request.resource.data.absenceDays == 0 &&
        request.resource.data.lateCount == 0 &&
        request.resource.data.pensionAmount == 0 &&
        request.resource.data.taxAmount == 0 &&
        request.resource.data.salaryUpdatedAt == "" &&
        request.resource.data.salaryUpdatedByName == "" &&
        request.resource.data.lastProfileNotification == "" &&
        request.resource.data.lastProfileNotificationAt == "" &&
        ((request.resource.data.jobLevel == "manager" && request.resource.data.accessLevel == "department_manager") ||
          (request.resource.data.jobLevel == "supervisor" && request.resource.data.accessLevel == "department_supervisor") ||
          (request.resource.data.jobLevel == "line_staff" && request.resource.data.accessLevel == "line_staff")) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        optionalListWithin(request.resource.data, "privileges", 40) &&
        optionalListWithin(request.resource.data, "leaveRecords", 120);
    }

    function selfProfileCanUpdate(userId) {
      return signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "fullName", "birthday", "phoneNumber", "homeAddress", "updatedAt"
        ]) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 80 &&
        request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 30 &&
        request.resource.data.homeAddress is string && request.resource.data.homeAddress.size() <= 250;
    }

    function hrCanUpdateUser(userId) {
      return isHumanResourceManager() && request.auth.uid != userId &&
        resource.data.isSuperAdmin != true &&
        request.resource.data.isSuperAdmin == false &&
        request.resource.data.accessLevel != "super_admin" &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "fullName", "birthday", "phoneNumber", "homeAddress", "departmentKey",
          "departmentName", "jobLevel", "staffTitle", "surcharges", "employmentStatus",
          "approvalStatus", "approvedAt", "approvedByName", "employmentStartDate",
          "sackedAt", "sackedByName", "accessLevel", "privileges", "leaveRecords",
          "monthlySalary", "payrollMonthKey", "absenceDays", "lateCount", "pensionAmount",
          "taxAmount", "salaryUpdatedAt", "salaryUpdatedByName", "lastProfileNotification",
          "lastProfileNotificationAt", "updatedAt"
        ]) && optionalListWithin(request.resource.data, "privileges", 40) &&
        optionalListWithin(request.resource.data, "leaveRecords", 120);
    }

    function housekeepingCanUpdateFrontOffice() {
      return isHousekeepingManager() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "cleanedRoomNumbers", "cleanedRooms", "otherCleanedAreas", "reportHistory",
          "housekeepingUpdatedAt", "housekeepingUpdatedByUid", "housekeepingUpdatedByName",
          "housekeepingUpdatedByDepartment"
        ]);
    }

    function housekeepingCanCreateFrontOffice() {
      return isHousekeepingManager() && request.resource.data.keys().hasOnly([
        "cleanedRoomNumbers", "cleanedRooms", "otherCleanedAreas", "reportHistory",
        "housekeepingUpdatedAt", "housekeepingUpdatedByUid", "housekeepingUpdatedByName",
        "housekeepingUpdatedByDepartment"
      ]);
    }

    function validFrontOfficeSize() {
      return optionalListWithin(request.resource.data, "occupiedRooms", 94) &&
        optionalListWithin(request.resource.data, "occupiedRoomNumbers", 94) &&
        optionalListWithin(request.resource.data, "cleanedRoomNumbers", 94) &&
        optionalListWithin(request.resource.data, "otherCleanedAreas", 40) &&
        optionalListWithin(request.resource.data, "roomMoves", 500) &&
        optionalListWithin(request.resource.data, "reportHistory", 120) &&
        optionalListWithin(request.resource.data, "activityEntries", 300);
    }

    function validFrontOfficeActor() {
      return request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedByUid == request.auth.uid &&
        matchesActorName(request.resource.data.updatedByName) &&
        matchesActorDepartment(request.resource.data.updatedByDepartment);
    }

    function frontOfficeCanCreate() {
      return isFrontOfficeManager() && validFrontOfficeActor() &&
        request.resource.data.keys().hasOnly([
          "occupiedRooms", "occupiedRoomNumbers", "roomMoves", "activityEntries",
          "reportHistory", "inHouse", "availableRooms", "breakfastEntitled",
          "cleanedRoomNumbers", "cleanedRooms", "notes", "updatedAt",
          "updatedByUid", "updatedByName", "updatedByDepartment"
        ]) &&
        (!request.resource.data.keys().hasAny(["cleanedRoomNumbers"]) ||
          request.resource.data.cleanedRoomNumbers.size() == 0) &&
        (!request.resource.data.keys().hasAny(["cleanedRooms"]) ||
          request.resource.data.cleanedRooms == 0);
    }

    function frontOfficeCanUpdate() {
      return isFrontOfficeManager() && validFrontOfficeActor() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "occupiedRooms", "occupiedRoomNumbers", "roomMoves", "activityEntries",
          "reportHistory", "inHouse", "availableRooms", "breakfastEntitled",
          "notes", "updatedAt", "updatedByUid", "updatedByName",
          "updatedByDepartment"
        ]);
    }

    function housekeepingCanUpdateMaintenance() {
      return isHousekeepingManager() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "roomIssues", "roomIssuesUpdatedAt", "roomIssuesUpdatedByUid",
          "roomIssuesUpdatedByName", "roomIssuesUpdatedByDepartment"
        ]);
    }

    function housekeepingCanCreateMaintenance() {
      return isHousekeepingManager() && request.resource.data.keys().hasOnly([
        "roomIssues", "roomIssuesUpdatedAt", "roomIssuesUpdatedByUid",
        "roomIssuesUpdatedByName", "roomIssuesUpdatedByDepartment"
      ]);
    }

    function nightDutyCanUpdateUtilities() {
      return isNightDutyManager() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "utilities", "utilitiesUpdatedAt", "utilitiesUpdatedByUid",
          "utilitiesUpdatedByName", "utilitiesUpdatedByDepartment"
        ]);
    }

    function nightDutyCanCreateUtilities() {
      return isNightDutyManager() && request.resource.data.keys().hasOnly([
        "utilities", "utilitiesUpdatedAt", "utilitiesUpdatedByUid",
        "utilitiesUpdatedByName", "utilitiesUpdatedByDepartment"
      ]);
    }

    function complaintLead() {
      return isFrontOfficeManager() || isHousekeepingManager() || isMaintenanceManager();
    }

    function complaintLeadCanUpdate() {
      return complaintLead() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "roomComplaints", "roomComplaintsUpdatedAt", "roomComplaintsUpdatedByUid",
          "roomComplaintsUpdatedByName", "roomComplaintsUpdatedByDepartment"
        ]);
    }

    function complaintLeadCanCreate() {
      return complaintLead() && request.resource.data.keys().hasOnly([
        "roomComplaints", "roomComplaintsUpdatedAt", "roomComplaintsUpdatedByUid",
        "roomComplaintsUpdatedByName", "roomComplaintsUpdatedByDepartment"
      ]);
    }

    function validMaintenanceSize() {
      return optionalListWithin(request.resource.data, "roomIssues", 94) &&
        optionalListWithin(request.resource.data, "roomComplaints", 300);
    }

    function validNightDutyReport() {
      return request.resource.data.keys().hasOnly([
          "operationalDateKey", "occupancyByFloor", "frontOfficeOccupancyByFloor",
          "frontOfficeOccupancyReport", "outOfOrderRoomNumbers",
          "occupancyQuery", "occupancyGuestMix", "income", "onDutyStaff", "departmentNotes",
          "gasLevels", "hotWaterTemperature", "generatorServices",
          "powerSupplies", "waterSupplyCount",
          "guestIncident", "employeeIncident", "nightDutySupervisorSignature",
          "utilitiesSnapshot", "eventsSnapshot", "complaintsSnapshot", "updatedAt",
          "updatedAtIso", "updatedByUid", "updatedByName", "updatedByDepartment"
        ]) &&
        request.resource.data.operationalDateKey is string &&
        request.resource.data.operationalDateKey.size() == 10 &&
        request.resource.data.occupancyByFloor is list &&
        optionalListWithin(request.resource.data, "occupancyByFloor", 8) &&
        request.resource.data.frontOfficeOccupancyByFloor is list &&
        optionalListWithin(request.resource.data, "frontOfficeOccupancyByFloor", 8) &&
        (request.resource.data.frontOfficeOccupancyReport == null ||
          request.resource.data.frontOfficeOccupancyReport is map) &&
        request.resource.data.outOfOrderRoomNumbers is list &&
        optionalListWithin(request.resource.data, "outOfOrderRoomNumbers", 94) &&
        request.resource.data.occupancyQuery is map &&
        request.resource.data.occupancyGuestMix is map &&
        request.resource.data.income is map &&
        request.resource.data.onDutyStaff is list &&
        optionalListWithin(request.resource.data, "onDutyStaff", 200) &&
        request.resource.data.departmentNotes is map &&
        request.resource.data.gasLevels is map &&
        (request.resource.data.hotWaterTemperature == null ||
          (request.resource.data.hotWaterTemperature is number &&
            request.resource.data.hotWaterTemperature >= 0 &&
            request.resource.data.hotWaterTemperature <= 120)) &&
        request.resource.data.generatorServices is list &&
        optionalListWithin(request.resource.data, "generatorServices", 20) &&
        request.resource.data.powerSupplies is list &&
        optionalListWithin(request.resource.data, "powerSupplies", 20) &&
        request.resource.data.waterSupplyCount is int &&
        request.resource.data.waterSupplyCount >= 0 &&
        request.resource.data.waterSupplyCount <= 1000 &&
        request.resource.data.guestIncident is map &&
        request.resource.data.employeeIncident is map &&
        request.resource.data.nightDutySupervisorSignature is string &&
        request.resource.data.nightDutySupervisorSignature.size() <= 120 &&
        request.resource.data.utilitiesSnapshot is map &&
        request.resource.data.eventsSnapshot is list &&
        optionalListWithin(request.resource.data, "eventsSnapshot", 100) &&
        request.resource.data.complaintsSnapshot is list &&
        optionalListWithin(request.resource.data, "complaintsSnapshot", 100) &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAtIso is string &&
        request.resource.data.updatedAtIso.size() <= 40 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedByName is string &&
        request.resource.data.updatedByName.size() <= 80 &&
        request.resource.data.updatedByDepartment is string &&
        request.resource.data.updatedByDepartment.size() <= 80;
    }

    function validNightDutySummary() {
      return request.resource.data.keys().hasOnly([
          "storageMode", "operationalDateKey", "occupancyByFloor", "occupancyGuestMix", "income",
          "frontOfficeOccupancyReport", "outOfOrderRoomNumbers",
          "gasLevels", "hotWaterTemperature", "waterSupplyCount",
          "nightDutySupervisorSignature", "updatedAt", "updatedAtIso",
          "updatedByUid", "updatedByName", "updatedByDepartment"
        ]) &&
        request.resource.data.storageMode == "d1-full" &&
        request.resource.data.operationalDateKey is string &&
        request.resource.data.operationalDateKey.size() == 10 &&
        request.resource.data.occupancyByFloor is list &&
        optionalListWithin(request.resource.data, "occupancyByFloor", 8) &&
        (request.resource.data.frontOfficeOccupancyReport == null ||
          request.resource.data.frontOfficeOccupancyReport is map) &&
        request.resource.data.outOfOrderRoomNumbers is list &&
        optionalListWithin(request.resource.data, "outOfOrderRoomNumbers", 94) &&
        request.resource.data.occupancyGuestMix is map &&
        request.resource.data.income is map &&
        request.resource.data.gasLevels is map &&
        (request.resource.data.hotWaterTemperature == null ||
          (request.resource.data.hotWaterTemperature is number &&
            request.resource.data.hotWaterTemperature >= 0 &&
            request.resource.data.hotWaterTemperature <= 120)) &&
        request.resource.data.waterSupplyCount is int &&
        request.resource.data.waterSupplyCount >= 0 &&
        request.resource.data.waterSupplyCount <= 1000 &&
        request.resource.data.nightDutySupervisorSignature is string &&
        request.resource.data.nightDutySupervisorSignature.size() <= 120 &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAtIso is string &&
        request.resource.data.updatedAtIso.size() <= 40 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedByName is string &&
        request.resource.data.updatedByName.size() <= 80 &&
        request.resource.data.updatedByDepartment is string &&
        request.resource.data.updatedByDepartment.size() <= 80;
    }

    function validInHouseReport() {
      return request.resource.data.keys().hasOnly([
          "storageMode", "operationalDateKey", "occupiedRooms", "occupiedRoomNumbers",
          "occupancyByFloor", "inHouse", "outOfOrderRoomNumbers", "availableRooms", "breakfastEntitled",
          "updatedAt", "updatedAtIso", "updatedByUid", "updatedByName",
          "updatedByDepartment"
        ]) &&
        (!request.resource.data.keys().hasAny(["storageMode"]) ||
          request.resource.data.storageMode == "d1-full") &&
        request.resource.data.operationalDateKey is string &&
        request.resource.data.operationalDateKey.size() == 10 &&
        request.resource.data.occupiedRooms is list &&
        request.resource.data.occupiedRooms.size() <= 94 &&
        request.resource.data.occupiedRoomNumbers is list &&
        request.resource.data.occupiedRoomNumbers.size() <= 94 &&
        request.resource.data.occupancyByFloor is list &&
        request.resource.data.occupancyByFloor.size() <= 8 &&
        request.resource.data.inHouse is int &&
        request.resource.data.inHouse >= 0 &&
        request.resource.data.inHouse <= 94 &&
        request.resource.data.outOfOrderRoomNumbers is list &&
        request.resource.data.outOfOrderRoomNumbers.size() <= 94 &&
        request.resource.data.availableRooms is int &&
        request.resource.data.availableRooms >= 0 &&
        request.resource.data.availableRooms <= 94 &&
        request.resource.data.breakfastEntitled is int &&
        request.resource.data.breakfastEntitled >= 0 &&
        request.resource.data.breakfastEntitled <= 1880 &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAtIso is string &&
        request.resource.data.updatedAtIso.size() <= 40 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        matchesActorName(request.resource.data.updatedByName) &&
        matchesActorDepartment(request.resource.data.updatedByDepartment);
    }

    function validRoomPropertyStatusReport() {
      return request.resource.data.keys().hasOnly([
          "roomNumber", "floorKey", "floorLabel", "inspectionDate",
          "sellabilityStatus", "items",
          "otherDamages", "updatedAt", "updatedAtIso", "updatedByUid",
          "updatedByName", "updatedByDepartment", "signedByName",
          "signedByTitle", "signedAtIso"
        ]) &&
        request.resource.data.roomNumber is string &&
        request.resource.data.roomNumber.size() > 0 &&
        request.resource.data.roomNumber.size() <= 20 &&
        request.resource.data.floorKey is string &&
        request.resource.data.floorKey.size() <= 40 &&
        request.resource.data.floorLabel is string &&
        request.resource.data.floorLabel.size() <= 80 &&
        request.resource.data.inspectionDate is string &&
        request.resource.data.inspectionDate.size() == 10 &&
        request.resource.data.sellabilityStatus in [
          "sellable", "sellable_80_percent", "sellable_last_resort", "not_sellable"
        ] &&
        request.resource.data.items is list &&
        (
          (request.resource.data.roomNumber == "105" &&
            request.resource.data.items.size() == 12) ||
          (request.resource.data.roomNumber != "105" &&
            request.resource.data.items.size() == 53)
        ) &&
        request.resource.data.otherDamages is string &&
        request.resource.data.otherDamages.size() <= 2000 &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAtIso is string &&
        request.resource.data.updatedAtIso.size() <= 40 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        matchesActorName(request.resource.data.updatedByName) &&
        matchesActorDepartment(request.resource.data.updatedByDepartment) &&
        matchesActorName(request.resource.data.signedByName) &&
        request.resource.data.signedByTitle == userData().staffTitle &&
        request.resource.data.signedAtIso is string &&
        request.resource.data.signedAtIso.size() <= 40;
    }

    function canWriteTrackedEntries() {
      return isSuperAdmin() || isLead() || belongsTo("store");
    }

    function validTrackedEntry() {
      return request.resource.data.actorUid == request.auth.uid &&
        matchesActorName(request.resource.data.actorName) &&
        matchesActorDepartment(request.resource.data.actorDepartment) &&
        matchesActorDepartmentKey(request.resource.data.actorDepartmentKey) &&
        request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 500;
    }

    function canReadNotification() {
      return isApprovedActive() && (
        resource.data.audienceTag == "all" ||
        (resource.data.audienceTag == "operations" && (isSuperAdmin() || isFrontOfficeManager() || isHousekeepingManager() || (belongsTo("food_beverages") && isLead()) || (belongsTo("night_duty") && isLead()))) ||
        (resource.data.audienceTag == "events" && (isSuperAdmin() || isLead())) ||
        (resource.data.audienceTag == "housekeeping_reports" && (isSuperAdmin() || isHousekeepingManager())) ||
        (resource.data.audienceTag == "property" && (isSuperAdmin() || isLead())) ||
        (resource.data.audienceTag == "store" && (isSuperAdmin() || belongsTo("store"))) ||
        (resource.data.audienceTag == "night-duty" && (isSuperAdmin() || isNightDutyManager()))
      );
    }

    match /users/{userId} {
      allow create: if validSelfRegistration(userId);
      allow get: if (signedIn() && request.auth.uid == userId) ||
        (isApprovedActive() && (
          isSuperAdmin() || isHumanResourceManager() || isAuditManager()
        ));
      allow list: if isApprovedActive() && (
        isSuperAdmin() || isHumanResourceManager() || isAuditManager()
      );
      allow update: if isSuperAdmin() || hrCanUpdateUser(userId) || selfProfileCanUpdate(userId);
      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    match /portal/highlights {
      allow read: if isApprovedActive();
      allow write: if isSuperAdmin();
    }

    match /portal/siteContent {
      allow read: if isApprovedActive();
      allow write: if isSuperAdmin() &&
        optionalListWithin(request.resource.data, "announcements", 100) &&
        optionalListWithin(request.resource.data, "newsItems", 100);
    }

    match /portal/frontOffice {
      allow read: if isSuperAdmin() || isFrontOfficeManager() || isHousekeepingManager() ||
        (belongsTo("food_beverages") && isLead()) || (belongsTo("night_duty") && isLead());
      allow create: if validFrontOfficeSize() &&
        (isSuperAdmin() || frontOfficeCanCreate() || housekeepingCanCreateFrontOffice());
      allow update: if validFrontOfficeSize() &&
        (isSuperAdmin() || frontOfficeCanUpdate() || housekeepingCanUpdateFrontOffice());
    }

    match /portal/operationsTargets {
      allow read: if isSuperAdmin() || isLead();
      allow create, update: if (isSuperAdmin() || isFrontOfficeManager() || isOperationsManager()) &&
        request.resource.data.keys().hasOnly([
          "monthlyTargets", "updatedAt", "updatedAtIso", "updatedByUid", "updatedByName"
        ]) &&
        request.resource.data.monthlyTargets is map &&
        request.resource.data.monthlyTargets.size() <= 120 &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAtIso is string &&
        request.resource.data.updatedAtIso.size() <= 40 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedByName is string &&
        request.resource.data.updatedByName.size() <= 80 &&
        matchesActorName(request.resource.data.updatedByName);
    }

    match /portal/maintenance {
      allow read: if isSuperAdmin() || isLead();
      allow create: if validMaintenanceSize() && (isSuperAdmin() || isMaintenanceManager() || housekeepingCanCreateMaintenance() || nightDutyCanCreateUtilities() || complaintLeadCanCreate());
      allow update: if validMaintenanceSize() && (isSuperAdmin() || isMaintenanceManager() || housekeepingCanUpdateMaintenance() || nightDutyCanUpdateUtilities() || complaintLeadCanUpdate());
    }

    match /portal/eventsBookings {
      allow read: if isSuperAdmin() || isLead();
      allow write: if optionalListWithin(request.resource.data, "events", 200) && (isSuperAdmin() || isFrontOfficeManager());
    }

    match /portal/housekeepingReports {
      allow read: if isSuperAdmin() || isHousekeepingManager();
      allow write: if optionalListWithin(request.resource.data, "morningRooms", 94) &&
        optionalListWithin(request.resource.data, "afternoonRooms", 94) &&
        (isSuperAdmin() || isHousekeepingManager());
    }

    match /roomPropertyStatus/{reportId} {
      allow read: if isSuperAdmin() || isLead();
      allow create, update: if (isSuperAdmin() || isHousekeepingManager()) &&
        validRoomPropertyStatusReport();
      allow delete: if false;
    }

    match /portal/storeInventory {
      allow read: if isSuperAdmin() || belongsTo("store");
      allow write: if optionalListWithin(request.resource.data, "acquisitions", 400) &&
        optionalListWithin(request.resource.data, "requisitions", 400) &&
        optionalListWithin(request.resource.data, "returns", 400) &&
        optionalListWithin(request.resource.data, "adjustments", 400) &&
        (isSuperAdmin() || isStoreLead());
    }

    match /portal/nightDuty {
      allow read: if isSuperAdmin() || isLead();
      allow write: if validNightDutyReport() && (isSuperAdmin() || isNightDutyManager());
    }

    match /nightDutyReports/{reportDate} {
      allow read: if isSuperAdmin() || isLead();
      allow create, update: if (
          (request.resource.data.keys().hasAny(["storageMode"]) && validNightDutySummary()) ||
          (!request.resource.data.keys().hasAny(["storageMode"]) && validNightDutyReport())
        ) &&
        request.resource.data.operationalDateKey == reportDate &&
        (isSuperAdmin() || isNightDutyManager());
      allow delete: if false;
    }

    match /inHouseReports/{reportDate} {
      allow read: if isSuperAdmin() || isLead();
      allow create, update: if validInHouseReport() &&
        request.resource.data.operationalDateKey == reportDate &&
        (isSuperAdmin() || isFrontOfficeManager());
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if canReadNotification();
      allow create: if canWriteTrackedEntries() && validTrackedEntry() &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120 &&
        request.resource.data.audienceTag in ["all", "operations", "events", "housekeeping_reports", "property", "store", "night-duty"];
    }

    match /activityLogs/{logId} {
      allow read: if isSuperAdmin() || isHumanResourceManager() || isAuditManager();
      allow create: if canWriteTrackedEntries() && validTrackedEntry();
    }

    match /departments/{departmentId} {
      allow read: if isSuperAdmin() || isHumanResourceManager() || isAuditManager() || belongsTo(departmentId);
      allow write: if optionalListWithin(request.resource.data, "shifts", 400) &&
        (isSuperAdmin() || (belongsTo(departmentId) && isLead()));
    }
  }
}
